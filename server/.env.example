# Environment
NODE_ENV=development
PORT=5000
API_VERSION=v1

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ridecompare?retryWrites=true&w=majority

# JWT Configuration
JWT_ACCESS_SECRET=replace-with-random-256-bit-hex-for-access-tokens
JWT_REFRESH_SECRET=replace-with-random-256-bit-hex-for-refresh-tokens
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth 2.0 (Platform Authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# Google Maps Platform
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Uber API
UBER_CLIENT_ID=your-uber-client-id
UBER_CLIENT_SECRET=your-uber-client-secret
UBER_REDIRECT_URI=http://localhost:5000/api/v1/providers/uber/callback
UBER_SANDBOX=true

# Ola API
OLA_APP_TOKEN=your-ola-app-token
OLA_CLIENT_ID=your-ola-client-id
OLA_CLIENT_SECRET=your-ola-client-secret
OLA_REDIRECT_URI=http://localhost:5000/api/v1/providers/ola/callback
OLA_SANDBOX=true

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Encryption (AES-256 for provider tokens at rest)
ENCRYPTION_KEY=replace-with-random-256-bit-hex-for-encryption
ENCRYPTION_IV_LENGTH=16

# Client URL (CORS whitelist)
CLIENT_URL=http://localhost:5173

# Redis (optional - for caching ride estimates)
REDIS_URL=redis://localhost:6379
